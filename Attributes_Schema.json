{
  "schema_name": "irap_image_annotation_schema",
  "schema_version": "1.0",
  "source": "iRAP Coding Manual - Drive on the left edition",
  "unit_of_annotation": "single image or image sequence representing a road segment",
  "notes": {
    "visibility_levels": ["direct", "partial", "not_image_only"],
    "recommended_labels_for_vlm": "Use direct + partial fields for image-based training. Keep not_image_only fields optional or null unless external metadata is available."
  },
  "fields": [
    {
      "id": "image_id",
      "category": "metadata",
      "type": "string",
      "observable_from_image": false,
      "description": "Unique image/sample ID"
    },
    {
      "id": "image_path",
      "category": "metadata",
      "type": "string",
      "observable_from_image": false,
      "description": "Path or URL to image"
    },
    {
      "id": "motorcycle_observed",
      "category": "observed_flow",
      "type": "single_choice",
      "observable_from_image": true,
      "choices": [
        { "label": "0"},
        { "label": "1"},
        { "label": "2_3"},
        { "label": "4_5"},
        { "label": "6_7"},
        { "label": "gt_8"}
      ]
    },
    {
      "id": "bicycle_observed",
      "category": "observed_flow",
      "type": "single_choice",
      "observable_from_image": true,
      "choices": [
        { "label": "0"},
        { "label": "1"},
        { "label": "2_3"},
        { "label": "4_5"},
        { "label": "6_7"},
        { "label": "gt_8"}
      ]
    },
    {
      "id": "ped_observed",
      "category": "observed_flow",
      "type": "single_choice",
      "observable_from_image": true,
      "choices": [
        { "label": "0"},
        { "label": "1"},
        { "label": "2_3"},
        { "label": "4_5"},
        { "label": "6_7"},
        { "label": "gt_8"}
      ]
    },
    {
      "id": "speed_sign_visible",
      "category": "speed",
      "type": "boolean",
      "observable_from_image": true
    },
    {
      "id": "speed_limit_general",
      "category": "speed",
      "type": "single_choice",
      "observable_from_image": "partial",
      "choices": [
        { "label": "30_kmh"},
        { "label": "40_kmh"},
        { "label": "50_kmh"},
        { "label": "60_kmh"},
        { "label": "70_kmh"},
        { "label": "80_kmh"},
        { "label": "90_kmh"},
        { "label": "100_kmh"},
        { "label": "110_kmh"}
